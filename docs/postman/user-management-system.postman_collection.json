          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bad Status\",\n  \"email\": \"pm.badstatus.{{runId}}@example.com\",\n  \"roleId\": {{userRoleId}},\n  \"status\": \"FOO\",\n  \"password\": \"Test@123\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Search finds the new user (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('The test user is in the results', () => {",
                  "    const ids = pm.response.json().map(u => u.id);",

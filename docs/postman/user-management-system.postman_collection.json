            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users?search=pm.test.{{runId}}"
          }
        },
        {
          "name": "Update user - set INACTIVE (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const u = pm.response.json();",
                  "",
                  "pm.test('Name, role and status were changed', () => {",
                  "    pm.expect(u.name).to.eql('Postman Test Updated');",
                  "    pm.expect(u.roleName).to.eql('MANAGER');",
                  "    pm.expect(u.status).to.eql('INACTIVE');",
                  "});",
                  "pm.test('createdAt did NOT change', () => {",
                  "    pm.expect(u.createdAt).to.eql(pm.collectionVariables.get('testUserCreatedAt'));",
                  "});",
                  "pm.test('No password sent -> the old password is kept', () => {",
                  "    pm.expect(u.hasPassword).to.eql(true);",
                  "});",
                  "pm.test('updatedAt moved forward', () => {",
                  "    pm.expect(u.updatedAt > pm.collectionVariables.get('testUserUpdatedAt')).to.be.true;",
                  "});",
                  "",
                  "pm.collectionVariables.set('testUserUpdatedAt', u.updatedAt);"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/users/{{testUserId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test Updated\",\n  \"email\": \"pm.test.{{runId}}@example.com\",\n  \"roleId\": {{managerRoleId}},\n  \"status\": \"INACTIVE\"\n}",
              "options": { "raw": { "language": "json" } }

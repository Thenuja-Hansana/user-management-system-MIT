    {
      "name": "5. Role deactivation flow - CHANGES REAL DATA",
      "description": "WARNING: this folder deactivates the MANAGER role. That moves ALL real MANAGER users to GUEST, and activating MANAGER again does NOT move them back. Only run it on test data, or move those users back by hand afterwards.\n\nSteps: create a test user with MANAGER -> deactivate MANAGER -> the user is now GUEST -> MANAGER cannot be assigned -> activate MANAGER -> the user stays GUEST -> delete the test user.",
      "item": [
        {
          "name": "Create flow user with MANAGER role (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('runId', Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const u = pm.response.json();",
                  "pm.test('Role is MANAGER', () => pm.expect(u.roleName).to.eql('MANAGER'));",
                  "pm.collectionVariables.set('flowUserId', u.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Flow User\",\n  \"email\": \"pm.flow.{{runId}}@example.com\",\n  \"roleId\": {{managerRoleId}},\n  \"password\": \"Test@123\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Deactivate MANAGER - users move to GUEST (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('MANAGER is now INACTIVE', () => pm.expect(r.status).to.eql('INACTIVE'));",
                  "pm.test('MANAGER has no users left', () => pm.expect(r.userCount).to.eql(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/roles/{{managerRoleId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"INACTIVE\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Flow user is now GUEST (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const u = pm.response.json();",
                  "pm.test('User was moved to GUEST', () => {",
                  "    pm.expect(u.roleName).to.eql('GUEST');",
                  "    pm.expect(u.roleId).to.eql(Number(pm.collectionVariables.get('guestRoleId')));",
                  "});",
                  "pm.test('Moving the user changed updatedAt', () => pm.expect(u.updatedAt > u.createdAt).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users/{{flowUserId}}"
          }
        },
        {
          "name": "List roles - MANAGER inactive, GUEST has users (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const roles = pm.response.json();",
                  "const manager = roles.find(r => r.name === 'MANAGER');",
                  "const guest = roles.find(r => r.name === 'GUEST');",
                  "pm.test('MANAGER is INACTIVE with 0 users', () => {",
                  "    pm.expect(manager.status).to.eql('INACTIVE');",
                  "    pm.expect(manager.userCount).to.eql(0);",
                  "});",
                  "pm.test('GUEST has at least 1 user', () => pm.expect(guest.userCount).to.be.at.least(1));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/roles"
          }
        },

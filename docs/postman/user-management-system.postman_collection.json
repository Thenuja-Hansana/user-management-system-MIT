{
  "info": {
    "name": "User Management System API",
    "description": "REST endpoints for the User Management System. Start the app first (default http://localhost:8080). Role ids: 1 ADMIN, 2 MANAGER, 3 USER, 4 GUEST (see GET /api/roles). Deactivating a role moves its users to GUEST.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "List all users (200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users"
          ]
        }
      }
    },
    {
      "name": "Search users by name or email (200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/users?search=an",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users"
          ],
          "query": [
            {
              "key": "search",
              "value": "an"
            }
          ]
        }
      }
    },
    {
      "name": "Get user by id (200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/users/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users",
            "1"
          ]
        }
      }
    },
    {
      "name": "Get user - not found (404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/users/9999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users",
            "9999"
          ]
        }
      }
    },
    {
      "name": "Get user - invalid id (400)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/users/abc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users",
            "abc"
          ]
        }
      }
    },
    {
      "name": "Create user (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test.user@example.com\",\n  \"roleId\": 3,\n  \"status\": \"ACTIVE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Create user - validation errors (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"\",\n  \"email\": \"not-an-email\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Create user - duplicate email (409)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Another Alice\",\n  \"email\": \"alice.perera@example.com\",\n  \"roleId\": 3\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Update user (200)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users/3",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users",
            "3"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Kasun Silva Updated\",\n  \"email\": \"kasun.silva@example.com\",\n  \"roleId\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Delete user (204)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/users/6",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users",
            "6"
          ]
        }
      }
    },
    {
      "name": "List all roles (200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/roles",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "roles"
          ]
        }
      }
    },
    {
      "name": "Deactivate role - users move to GUEST (200)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/roles/2/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "roles",
            "2",
            "status"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"INACTIVE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Activate role (200)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/roles/2/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "roles",
            "2",
            "status"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"ACTIVE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Deactivate GUEST - not allowed (400)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/roles/4/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "roles",
            "4",
            "status"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"INACTIVE\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ]
}